# MongoDB Credentials
MONGODB_USER=your_mongodb_user
MONGODB_PASSWORD=your_mongodb_password
MONGODB_DB=absa

# Connection URI (adjust host/port if running outside docker)
MONGODB_URI=mongodb://your_mongodb_user:your_mongodb_password@mongodb:27017/absa?authSource=admin

# Cloudflare Tunnel Token for UAT (Optional)
CLOUDFLARE_TUNNEL_TOKEN_UAT=your_cloudflare_tunnel_token
